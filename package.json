{
  "name": "@vladcuciureanu/vernon",
  "version": "2.0.0",
  "private": true,
  "description": "Generate humorous obituaries for deleted code using git history",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vernon": "./dist/bin/vernon.js"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch bin/vernon.ts",
    "start": "node bin/vernon.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "biome lint",
    "format": "biome check --write",
    "check": "biome check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26",
    "typescript": "^7.0.2"
  }
}
